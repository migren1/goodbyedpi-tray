<Window x:Class="GoodbyeDpiTray.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        Background="Transparent"
        Topmost="True"
        ShowActivated="True"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

  <Border x:Name="Panel" CornerRadius="12" Padding="16">
    <StackPanel Width="208">

      <!-- Baslik + durum rozeti -->
      <Grid Margin="2,0,2,14">
        <TextBlock x:Name="TitleText" Text="GoodbyeDPI"
                   FontSize="14" FontWeight="SemiBold"
                   VerticalAlignment="Center" HorizontalAlignment="Left" />
        <Border x:Name="Badge" CornerRadius="9" Padding="8,2"
                HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock x:Name="BadgeText" FontSize="11" FontWeight="Medium" />
        </Border>
      </Grid>

      <!-- Buyuk ac/kapa anahtari -->
      <Border x:Name="Track" Height="44" CornerRadius="22" Cursor="Hand"
              MouseLeftButtonUp="OnTrackClick">
        <Grid>
          <TextBlock x:Name="SwitchLabel" FontSize="12.5" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
          <Border x:Name="Thumb" Width="36" Height="36" CornerRadius="18"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"
                  IsHitTestVisible="False">
            <Border.RenderTransform>
              <TranslateTransform x:Name="ThumbShift" X="0" />
            </Border.RenderTransform>
          </Border>
        </Grid>
      </Border>

      <!-- Alt ipucu -->
      <TextBlock x:Name="HintText"
                 FontSize="10.5" TextAlignment="Center" Margin="0,12,0,0" />
    </StackPanel>
  </Border>
</Window>
